{
  "name": "@cadence/desktop",
  "version": "0.1.0",
  "productName": "Cadence",
  "private": true,
  "description": "Cadence desktop app (Electron + React)",
  "main": "./out/main/index.js",
  "author": "Harry",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p e2e/tsconfig.json",
    "e2e": "pnpm build && playwright test -c e2e/playwright.config.ts",
    "rebuild:native": "electron-builder install-app-deps",
    "icon": "node scripts/generate-icon.mjs"
  },
  "dependencies": {
    "@cadence/content": "workspace:*",
    "@cadence/core": "workspace:*",
    "@cadence/db": "workspace:*",
    "@cadence/music": "workspace:*",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@tanstack/react-query": "^5.104.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "electron-log": "^5.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0"
  }
}
